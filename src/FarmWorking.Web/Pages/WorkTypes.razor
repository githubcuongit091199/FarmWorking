@page "/work-types"
@inject FarmApi Api
<PageTitle>Giá công việc · Lá Farm</PageTitle>
<div class="page-heading"><div><span class="eyebrow">NHÂN CÔNG</span><h1>Công việc và đơn giá</h1><p>Quản lý tiền công cho một ngày làm việc theo từng loại công việc.</p></div><button class="btn primary" @onclick="OpenCreate">+ Thêm công việc</button></div>
<section class="panel"><div class="data-table"><div class="table-head work-type-row"><span>Công việc</span><span>Đơn giá / ngày</span><span>Trạng thái</span><span></span></div>@if(items.Count==0){<div class="empty">Chưa có công việc nào.</div>}@foreach(var item in items){<div class="table-row work-type-row"><strong>@item.Name</strong><strong class="farm-price">@Money(item.DailyRate)</strong><span class="tag @(item.IsActive?"":"inactive-tag")">@(item.IsActive?"Đang sử dụng":"Ngừng sử dụng")</span><span class="row-actions"><button class="btn ghost small" @onclick="()=>OpenEdit(item)">Sửa</button><button class="btn danger small" @onclick="()=>Remove(item.Id)">Xóa</button></span></div>}</div></section>
@if(showForm){<div class="modal-backdrop" @onclick="Close"><div class="modal" @onclick:stopPropagation><div class="modal-head"><div><span class="eyebrow">ĐƠN GIÁ NHÂN CÔNG</span><h2>@(editingId.HasValue?"Sửa công việc":"Thêm công việc")</h2></div><button class="icon-btn" @onclick="Close">×</button></div><EditForm Model="model" OnValidSubmit="Save"><div class="form-grid"><label>Tên công việc<input required @bind="model.Name" placeholder="Ví dụ: Phun thuốc"/></label><label>Đơn giá một ngày<input required type="number" min="0" step="1000" @bind="model.DailyRate"/></label><label class="wide checkbox-label"><input type="checkbox" @bind="model.IsActive"/> Đang sử dụng</label></div><div class="modal-actions"><button type="button" class="btn ghost" @onclick="Close">Hủy</button><button class="btn primary">Lưu</button></div></EditForm></div></div>}
@code{List<WorkType> items=[];WorkType model=New();Guid? editingId;bool showForm;protected override async Task OnInitializedAsync()=>items=await Api.WorkTypes();void OpenCreate(){editingId=null;model=New();showForm=true;}void OpenEdit(WorkType x){editingId=x.Id;model=new(){Id=x.Id,Name=x.Name,DailyRate=x.DailyRate,IsActive=x.IsActive};showForm=true;}void Close(){showForm=false;}async Task Save(){if(editingId.HasValue)await Api.UpdateWorkType(editingId.Value,model);else await Api.AddWorkType(model);items=await Api.WorkTypes();Close();}async Task Remove(Guid id){try{await Api.DeleteWorkType(id);items=await Api.WorkTypes();}catch(HttpRequestException){}}static WorkType New()=>new(){IsActive=true};static string Money(decimal x)=>x.ToString("N0",new CultureInfo("vi-VN"))+" ₫";}
