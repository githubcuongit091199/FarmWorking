@page "/transactions"
@inject FarmApi Api
<PageTitle>Thu & chi · Lá Farm</PageTitle>
<div class="page-heading"><div><span class="eyebrow">TÀI CHÍNH</span><h1>Thu & chi</h1><p>Theo dõi dòng tiền của toàn bộ nông trại.</p></div><button class="btn primary" @onclick="() => showForm=true">+ Thêm giao dịch</button></div>
<div class="finance-summary"><div><span>TỔNG THU</span><strong class="money-in">@Money(items.Where(x=>x.Type==TransactionType.Income).Sum(x=>x.Amount))</strong></div><div><span>TỔNG CHI</span><strong class="money-out">@Money(items.Where(x=>x.Type==TransactionType.Expense).Sum(x=>x.Amount))</strong></div><div><span>SỐ DƯ</span><strong>@Money(items.Sum(x=>x.Type==TransactionType.Income?x.Amount:-x.Amount))</strong></div></div>
<section class="panel"><div class="panel-head"><div><h2>Lịch sử giao dịch</h2><p>@Filtered.Count() giao dịch</p></div><div class="transaction-filters"><select class="filter" @bind="farmFilter"><option value="all" hidden="@(farmFilter=="all")">Tất cả nông trại</option>@foreach(var farm in farms){<option value="@farm.Id">@farm.Name</option>}</select><select class="filter" @bind="filter"><option value="all" hidden="@(filter=="all")">Tất cả thu chi</option><option value="income">Khoản thu</option><option value="expense">Khoản chi</option></select></div></div><div class="data-table"><div class="table-head"><span>Ngày</span><span>Nội dung</span><span>Trang trại</span><span>Tag</span><span>Số tiền</span></div>@if(!Filtered.Any()){<div class="empty">Không có giao dịch phù hợp.</div>}@foreach(var t in Filtered){<div class="table-row"><span>@t.TransactionDate.ToString("dd/MM/yyyy")</span><strong>@t.Description</strong><span>@FarmName(t.FarmId)</span><span><em class="tag">@t.Tag</em></span><strong class="@(t.Type==TransactionType.Income?"money-in":"money-out")">@(t.Type==TransactionType.Income?"+":"-")@Money(t.Amount)</strong></div>}</div></section>
@if(showForm){<div class="modal-backdrop" @onclick="()=>showForm=false"><div class="modal" @onclick:stopPropagation><div class="modal-head"><div><span class="eyebrow">GIAO DỊCH MỚI</span><h2>Ghi nhận thu chi</h2></div><button class="icon-btn" @onclick="()=>showForm=false">×</button></div><EditForm Model="model" OnValidSubmit="Save"><div class="type-toggle"><button type="button" class="@(model.Type==TransactionType.Income?"active income":"")" @onclick="()=>model.Type=TransactionType.Income">↗ Khoản thu</button><button type="button" class="@(model.Type==TransactionType.Expense?"active expense":"")" @onclick="()=>model.Type=TransactionType.Expense">↘ Khoản chi</button></div><div class="form-grid"><label>Trang trại<select @bind="model.FarmId" required><option value="" disabled hidden>Chọn nông trại</option>@foreach(var f in farms){<option value="@f.Id">@f.Name</option>}</select></label><label>Ngày giao dịch<input type="date" @bind="model.TransactionDate" /></label><label>Số tiền<input type="number" min="0" @bind="model.Amount" required /></label><label>Tag<input list="finance-tags" @bind="model.Tag" required placeholder="Nhập hoặc chọn tag"/><datalist id="finance-tags">@foreach(var tag in tags.Where(x=>x.Type==model.Type)){<option value="@tag.Name"/>}</datalist><small>Tag mới sẽ được tự động tạo</small></label><label class="wide">Nội dung<input @bind="model.Description" required /></label></div><div class="modal-actions"><button class="btn primary">Lưu giao dịch</button></div></EditForm></div></div>}
@code { List<FarmTransaction> items=[]; List<Farm> farms=[]; List<FinanceTag> tags=[]; FarmTransaction model=new(); bool showForm; string filter="all"; string farmFilter="all"; IEnumerable<FarmTransaction> Filtered=>items.Where(x=>(farmFilter=="all"||x.FarmId.ToString()==farmFilter)&&(filter=="all"||(filter=="income"&&x.Type==TransactionType.Income)||(filter=="expense"&&x.Type==TransactionType.Expense))); protected override async Task OnInitializedAsync(){farms=await Api.Farms();items=await Api.Transactions();tags=await Api.Tags();if(farms.Count>0)model.FarmId=farms[0].Id;} async Task Save(){await Api.AddTransaction(model);items=await Api.Transactions();tags=await Api.Tags();model=new(){FarmId=farms.FirstOrDefault()?.Id??Guid.Empty};showForm=false;} string FarmName(Guid id)=>farms.FirstOrDefault(x=>x.Id==id)?.Name??"—"; static string Money(decimal v)=>v.ToString("N0",new CultureInfo("vi-VN"))+" ₫"; }
