@page "/farms/{Id:guid}"
@inject FarmApi Api
@inject IJSRuntime JS
<PageTitle>Chi tiết nông trại · Lá Farm</PageTitle>

@if(detail is null){<div class="loading">Đang tải nông trại...</div>}
else
{
    <a class="back-link" href="farms">← Tất cả nông trại</a>
    <div class="farm-hero"><div><span class="eyebrow">@detail.Farm.Crop</span><h1>@detail.Farm.Name</h1><p>⌖ @detail.Farm.Location · @detail.Farm.Area @detail.Farm.AreaUnit</p></div><button class="btn primary" @onclick="()=>showNote=true">+ Ghi nhật ký</button></div>
    <div class="detail-grid">
        <div class="farm-detail-main">
            <section class="panel"><div class="panel-head"><div><h2>Nhân công tại nông trại</h2><p>Thêm mới, chọn nhân công có sẵn hoặc chuyển sang nông trại khác</p></div><div class="worker-heading-actions"><button class="btn ghost small" @onclick="OpenAssignWorker">Chọn nhân công có sẵn</button><button class="btn primary small" @onclick="OpenAddWorker">+ Thêm nhân công</button></div></div>
                @if(FarmWorkers.Count==0){<div class="empty">Nông trại chưa có nhân công.</div>}
                <div class="farm-worker-list">@foreach(var worker in FarmWorkers){var payroll=PayrollOf(worker.Id);<div class="farm-worker-item payroll-worker"><div><strong>@worker.FullName</strong><small>@(string.IsNullOrWhiteSpace(worker.Role)?"Chưa ghi vai trò":worker.Role) · @(worker.IsActive?"Đang làm việc":"Đã nghỉ")</small></div><div class="payroll-balance"><strong>@Money(payroll.UnpaidAmount)</strong><small>@payroll.UnpaidDays ngày công chưa trả</small></div><div class="row-actions"><button class="btn ghost small" disabled="@(!worker.IsActive)" @onclick="()=>OpenWorkDay(worker)">+ Tính công</button><button class="btn primary small" disabled="@(payroll.UnpaidDays==0)" @onclick="()=>OpenSettlement(worker)">Tất toán lương</button></div></div>}</div>
            </section>
            <section class="panel"><div class="panel-head"><div><h2>Vật tư tại nông trại</h2><p>Tồn kho được cộng dồn từ từng lần cung cấp vật tư</p></div><button class="btn primary small" @onclick="OpenProvision">+ Cung cấp vật tư</button></div>
                @if(Stocks.Count==0){<div class="empty">Nông trại chưa được cung cấp vật tư.</div>}
                <div class="farm-stock-grid">@foreach(var stock in Stocks){<article class="farm-stock-card @(stock.Remaining<=0?"out":"")"><div><span class="eyebrow">@(stock.Type==SupplyType.Fertilizer?"PHÂN BÓN":"THUỐC")</span><h3>@stock.Name</h3><span class="stock-price-badge">@Money2(stock.UnitPrice) / @stock.Unit</span><small>@stock.EntryCount lần nhập cùng mức giá</small></div><div class="stock-quantity"><strong>@stock.Remaining @stock.Unit</strong><small>Tổng nhập @stock.Received @stock.Unit</small></div><div class="stock-actions"><button class="btn ghost small" @onclick="()=>OpenHistory(stock.SupplyId,stock.SupplyPriceId)">Lịch sử</button><button class="btn primary small" disabled="@(stock.Remaining<=0)" @onclick="()=>OpenUse(stock)">Ghi nhận sử dụng</button></div></article>}</div>
            </section>
            <section class="panel"><div class="panel-head"><div><h2>Quy trình áp dụng</h2><p>Các quy trình được gán cho nông trại này</p></div><a href="processes">Quản lý quy trình →</a></div>
                @if(detail.Processes.Count==0){<div class="empty">Chưa có quy trình nào được gán.</div>}
                <div class="farm-process-list">@foreach(var process in detail.Processes.OrderBy(x=>x.Name)){var extras=ExtraSteps(process.Id);<article class="farm-process-item @(process.IsDeleted?"deleted":"")"><div><span class="eyebrow">@process.CropType</span><h3>@process.Name</h3><p>@process.Description</p></div><span class="steps-count">@(process.Steps.Count+extras.Count) bước</span>@if(process.IsDeleted){<em>Đã xóa</em>}<div class="farm-process-steps">@foreach(var step in process.Steps.OrderBy(x=>x.Order)){<span><b>@step.Order</b> @step.Title <small>Ngày +@step.DayOffset · Bước chuẩn</small></span>}@foreach(var step in extras){<span class="extra-process-step"><b>+@step.Order</b><span>@step.Title <small>Ngày +@step.DayOffset · Bước riêng của nông trại</small></span><button class="icon-btn extra-step-delete" title="Xóa bước riêng" @onclick="()=>DeleteExtraStep(process.Id,step)">×</button></span>}</div>@if(!process.IsDeleted){<div class="farm-process-actions"><button class="btn small ghost add-extra-step" @onclick="()=>OpenExtraStep(process)">+ Thêm bước riêng</button><button class="btn small primary" @onclick="()=>OpenStartRun(process)">▶ Bắt đầu mùa vụ</button></div>}</article>}</div>
            </section>
            <section class="panel"><div class="panel-head"><div><h2>Mùa vụ & tiến độ</h2><p>Theo dõi từng lần thực hiện quy trình theo năm hoặc mùa vụ</p></div></div>
                @if(detail.ProcessRuns.Count==0){<div class="empty">Chưa bắt đầu mùa vụ nào.</div>}
                <div class="process-run-list">@foreach(var run in detail.ProcessRuns.OrderBy(x=>x.CompletedAt.HasValue).ThenByDescending(x=>x.StartDate)){var done=run.Steps.Count(x=>x.CompletedAt.HasValue);var percent=run.Steps.Count==0?0:done*100/run.Steps.Count;<article class="process-run @(run.CompletedAt.HasValue?"completed":"active")"><div class="run-head"><div><span class="eyebrow">@run.SeasonName</span><h3>@run.ProcessName</h3><small>Bắt đầu @run.StartDate.ToString("dd/MM/yyyy") @if(run.CompletedAt.HasValue){<text>· Kết thúc @run.CompletedAt.Value.ToLocalTime().ToString("dd/MM/yyyy")</text>}</small></div><strong>@(run.CompletedAt.HasValue?"Đã hoàn tất":$"{done}/{run.Steps.Count} bước")</strong></div><div class="run-progress"><i style="width:@percent%"></i></div><div class="run-steps">@foreach(var step in run.Steps.OrderBy(x=>x.Order)){<label class="@(step.CompletedAt.HasValue?"done":"")"><input type="checkbox" checked="@step.CompletedAt.HasValue" @onchange="e=>ToggleRunStep(run,step,(bool)e.Value!)"/><b>@step.Order</b><span>@step.Title <small>Ngày +@step.DayOffset @(step.IsFarmExtra?"· Bước riêng":"")</small></span></label>}</div></article>}</div>
            </section>
            <section class="panel"><div class="panel-head"><div><h2>Nhật ký công việc</h2><p>Hoạt động đã thực hiện tại nông trại</p></div></div><div class="timeline">@if(detail.Notes.Count==0){<div class="empty">Chưa có ghi chú công việc.</div>}@foreach(var note in detail.Notes){<article><div class="timeline-dot"></div><time>@note.WorkDate.ToString("dd/MM/yyyy")</time><h3>@note.Title</h3><p>@note.Content</p><small>Thực hiện bởi @note.Worker</small></article>}</div></section>
        </div>
        <aside><div class="info-card"><span class="eyebrow">GIỚI THIỆU</span><p>@detail.Farm.Description</p></div><div class="info-card"><span class="eyebrow">TÀI CHÍNH</span><div class="balance"><span>Thu</span><strong class="money-in">@Money(detail.Transactions.Where(x=>x.Type==TransactionType.Income).Sum(x=>x.Amount))</strong></div><div class="balance"><span>Chi</span><strong class="money-out">@Money(detail.Transactions.Where(x=>x.Type==TransactionType.Expense).Sum(x=>x.Amount))</strong></div></div></aside>
    </div>
}

@if(showNote){<div class="modal-backdrop" @onclick="()=>showNote=false"><div class="modal" @onclick:stopPropagation><div class="modal-head"><h2>Ghi nhật ký công việc</h2><button class="icon-btn" @onclick="()=>showNote=false">×</button></div><EditForm Model="note" OnValidSubmit="SaveNote"><div class="form-grid"><label>Ngày thực hiện<input type="date" @bind="note.WorkDate" /></label><label>Người thực hiện<select required @bind="note.Worker"><option value="" disabled hidden>Chọn nhân công của trại</option>@foreach(var worker in SelectableFarmWorkers){<option value="@worker.FullName">@worker.FullName</option>}</select></label><label class="wide">Tên công việc<input required @bind="note.Title" /></label><label class="wide">Nội dung<textarea required rows="4" @bind="note.Content"></textarea></label></div><div class="modal-actions"><button class="btn primary">Lưu nhật ký</button></div></EditForm></div></div>}

@if(showExtraStep){<div class="modal-backdrop" @onclick="CloseExtraStep"><div class="modal" @onclick:stopPropagation><div class="modal-head"><div><span class="eyebrow">BƯỚC RIÊNG CỦA NÔNG TRẠI</span><h2>@selectedProcessName</h2></div><button class="icon-btn" @onclick="CloseExtraStep">×</button></div><EditForm Model="extraStep" OnValidSubmit="SaveExtraStep"><div class="form-grid"><label class="wide">Tên bước<input required @bind="extraStep.Title" /></label><label>Ngày bắt đầu (+)<input type="number" min="0" @bind="extraStep.DayOffset" /></label><label class="wide">Mô tả<textarea rows="3" @bind="extraStep.Description"></textarea></label></div><div class="modal-actions"><button type="button" class="btn ghost" @onclick="CloseExtraStep">Đóng</button><button class="btn primary">Thêm vào nông trại</button></div></EditForm></div></div>}

@if(showStartRun){<div class="modal-backdrop" @onclick="CloseStartRun"><div class="modal" @onclick:stopPropagation><div class="modal-head"><div><span class="eyebrow">BẮT ĐẦU MÙA VỤ</span><h2>@selectedProcessName</h2></div><button class="icon-btn" @onclick="CloseStartRun">×</button></div><EditForm Model="runRequest" OnValidSubmit="StartRun"><div class="form-grid"><label>Tên mùa vụ<input required @bind="runRequest.SeasonName" /></label><label>Ngày bắt đầu<input type="date" @bind="runRequest.StartDate" /></label></div><div class="modal-actions"><button type="button" class="btn ghost" @onclick="CloseStartRun">Đóng</button><button class="btn primary">Bắt đầu</button></div></EditForm></div></div>}

@if(showProvision){<div class="modal-backdrop" @onclick="CloseProvision"><div class="modal" @onclick:stopPropagation><div class="modal-head"><div><span class="eyebrow">NHẬP KHO NÔNG TRẠI</span><h2>Cung cấp vật tư</h2></div><button class="icon-btn" @onclick="CloseProvision">×</button></div><EditForm Model="provision" OnValidSubmit="SaveProvision"><div class="form-grid"><label class="wide">Vật tư<select required @bind="provision.SupplyId" @bind:after="LoadSelectedPrices"><option value="@Guid.Empty" disabled hidden>Chọn phân hoặc thuốc</option>@foreach(var x in allSupplies){<option value="@x.Id">@(x.Type==SupplyType.Fertilizer?"Phân":"Thuốc") · @x.Name</option>}</select></label><label>Mức giá<select required @bind="provision.SupplyPriceId"><option value="@Guid.Empty" disabled hidden>Chọn mức giá</option>@foreach(var x in selectedPrices){<option value="@x.Id">@Money2(x.Price) / @SelectedSupplyUnit</option>}</select><small>Giá được quản lý tại trang Bộ giá vật tư.</small></label><label>Số lượng (@SelectedSupplyUnit)<input required type="number" min="0.01" step="0.01" @bind="provision.Quantity"/></label><label>Ngày nhập<input type="date" @bind="provision.ReceivedAt"/></label></div>@if(!string.IsNullOrWhiteSpace(stockError)){<div class="upload-error form-error">@stockError</div>}<div class="modal-actions"><button type="button" class="btn ghost" @onclick="CloseProvision">Hủy</button><button class="btn primary">Nhập kho</button></div></EditForm></div></div>}

@if(showUse){<div class="modal-backdrop" @onclick="CloseUse"><div class="modal" @onclick:stopPropagation><div class="modal-head"><div><span class="eyebrow">XUẤT KHO · NHẬT KÝ · CHI PHÍ</span><h2>Ghi nhận sử dụng @selectedStock?.Name</h2></div><button class="icon-btn" @onclick="CloseUse">×</button></div><EditForm Model="useRequest" OnValidSubmit="SaveUse"><div class="form-grid"><label>Số lượng sử dụng (@selectedStock?.Unit)<input required type="number" min="0.01" max="@selectedStock?.Remaining" step="0.01" @bind="useRequest.Quantity"/><small>Đang tồn: @selectedStock?.Remaining @selectedStock?.Unit.</small></label><label>Ngày sử dụng<input required type="date" @bind="useRequest.UsedAt"/></label><label class="wide">Người thực hiện<select required @bind="useRequest.Worker"><option value="" disabled hidden>Chọn nhân công của trại</option>@foreach(var worker in SelectableFarmWorkers){<option value="@worker.FullName">@worker.FullName</option>}</select></label><label class="wide">Ghi chú<textarea rows="3" @bind="useRequest.Notes" placeholder="Mục đích, khu vực sử dụng..."></textarea><small>Hệ thống trừ đúng nhóm giá, tạo nhật ký và khoản chi.</small></label></div>@if(!string.IsNullOrWhiteSpace(stockError)){<div class="upload-error form-error">@stockError</div>}<div class="modal-actions"><button type="button" class="btn ghost" @onclick="CloseUse">Hủy</button><button class="btn primary">Xác nhận sử dụng</button></div></EditForm></div></div>}

@if(showWorkerForm){<div class="modal-backdrop" @onclick="CloseWorkerForm"><div class="modal" @onclick:stopPropagation><div class="modal-head"><div><span class="eyebrow">NHÂN CÔNG CỦA @detail?.Farm.Name</span><h2>Thêm nhân công</h2></div><button class="icon-btn" @onclick="CloseWorkerForm">×</button></div><EditForm Model="workerModel" OnValidSubmit="SaveWorker"><div class="form-grid"><label>Họ và tên<input required @bind="workerModel.FullName"/></label><label>Số điện thoại<input type="tel" @bind="workerModel.Phone"/></label><label>Địa chỉ<input @bind="workerModel.Address"/></label><label>Công việc / vai trò<input @bind="workerModel.Role"/></label><label>Ngày bắt đầu<input type="date" @bind="workerModel.StartDate"/></label><label class="wide">Ghi chú<textarea rows="3" @bind="workerModel.Notes"></textarea></label></div><div class="modal-actions"><button type="button" class="btn ghost" @onclick="CloseWorkerForm">Hủy</button><button class="btn primary">Thêm vào trại</button></div></EditForm></div></div>}

@if(showAssignWorker){<div class="modal-backdrop" @onclick="CloseAssignWorker"><div class="modal" @onclick:stopPropagation><div class="modal-head"><div><span class="eyebrow">PHÂN CÔNG NHÂN SỰ</span><h2>Chọn nhân công cho trại</h2></div><button class="icon-btn" @onclick="CloseAssignWorker">×</button></div><div class="form-grid"><label class="wide">Nhân công<select @bind="selectedWorkerId"><option value="@Guid.Empty" disabled hidden>Chọn nhân công</option>@foreach(var worker in AssignableWorkers){<option value="@worker.Id">@worker.FullName</option>}</select><small>Chỉ hiển thị nhân công chưa được phân vào nông trại.</small></label></div><div class="modal-actions"><button type="button" class="btn ghost" @onclick="CloseAssignWorker">Hủy</button><button class="btn primary" @onclick="AssignWorker">Phân công vào trại</button></div></div></div>}

@if(showPayrollAction){<div class="modal-backdrop" @onclick="ClosePayrollAction"><div class="modal" @onclick:stopPropagation><div class="modal-head"><div><span class="eyebrow">@(settlingPayroll?"THANH TOÁN TIỀN CÔNG":"CHẤM CÔNG THEO CÔNG VIỆC")</span><h2>@payrollWorker?.FullName</h2></div><button class="icon-btn" @onclick="ClosePayrollAction">×</button></div>@if(settlingPayroll){var payroll=PayrollOf(payrollWorker!.Id);<div class="payroll-settlement-summary"><span>Số công chưa trả</span><strong>@payroll.UnpaidDays.ToString("N2") công</strong><span>Tổng tiền tất toán</span><strong>@Money(payroll.UnpaidAmount)</strong></div><div class="form-grid"><label class="wide">Ngày thanh toán<input type="date" @bind="payrollDate"/></label></div>}else{<div class="form-grid"><label>Ngày làm việc<input type="date" @bind="payrollDate" @bind:after="ValidatePayrollDate"/></label><label>Công việc<select @bind="selectedWorkTypeId"><option value="@Guid.Empty" disabled hidden>Chọn công việc</option>@foreach(var type in ActiveWorkTypes){<option value="@type.Id">@type.Name · @Money(type.DailyRate)/ngày</option>}</select></label><label>Phần ngày công<input type="number" min="0.01" max="1" step="0.25" @bind="workFraction"/><small>Ví dụ: 0,5 cho nửa ngày; 1 cho cả ngày.</small></label><label>Tiền công dự kiến<input readonly value="@Money(EstimatedWage)"/></label></div>}@if(!string.IsNullOrWhiteSpace(payrollError)){<div class="upload-error form-error">@payrollError</div>}<div class="modal-actions"><button type="button" class="btn ghost" @onclick="ClosePayrollAction">Hủy</button><button class="btn primary" disabled="@(!settlingPayroll&&SelectedWorkDateIsFull)" @onclick="SavePayrollAction">@(settlingPayroll?"Tất toán và ghi khoản chi":"Thêm công việc")</button></div></div></div>}

@if(showHistory){<div class="modal-backdrop" @onclick="()=>showHistory=false"><div class="modal large" @onclick:stopPropagation><div class="modal-head"><div><span class="eyebrow">LỊCH SỬ NHẬP KHO</span><h2>@historyEntries.FirstOrDefault()?.SupplyName</h2></div><button class="icon-btn" @onclick="()=>showHistory=false">×</button></div><div class="stock-history">@foreach(var x in historyEntries){<div><span>@x.ReceivedAt.ToString("dd/MM/yyyy")</span><strong>Nhập @x.Quantity @x.Unit</strong><span>@Money2(x.UnitPrice) / @x.Unit</span><span>Còn @x.RemainingQuantity @x.Unit</span></div>}</div></div></div>}

@code {
    [Parameter]public Guid Id{get;set;} FarmDetail? detail;bool showNote;WorkNote note=new();bool showExtraStep;bool showStartRun;Guid selectedProcessId;string selectedProcessName="";FarmProcessExtraStep extraStep=new();StartFarmProcessRunRequest runRequest=new();
    List<Supply> allSupplies=[];List<FarmSupplyEntry> farmSupplyEntries=[];List<SupplyPrice> selectedPrices=[];ProvisionFarmSupplyRequest provision=new();UseFarmSupplyRequest useRequest=new();StockRow? selectedStock;bool showProvision,showUse,showHistory;List<FarmSupplyEntry> historyEntries=[];string stockError="";
    List<Worker> allWorkers=[];Worker workerModel=NewWorker();bool showWorkerForm,showAssignWorker;Guid selectedWorkerId;
    List<WorkerPayroll> payrolls=[];List<WorkType> workTypes=[];Worker? payrollWorker;DateTime payrollDate=DateTime.Today;Guid selectedWorkTypeId;decimal workFraction=1;bool showPayrollAction,settlingPayroll;string payrollError="";
    List<WorkType> ActiveWorkTypes=>workTypes.Where(x=>x.IsActive).OrderBy(x=>x.Name).ToList();
    decimal EstimatedWage=>Math.Round((workTypes.FirstOrDefault(x=>x.Id==selectedWorkTypeId)?.DailyRate??0)*workFraction,2);
    List<Worker> FarmWorkers=>allWorkers.Where(x=>x.FarmId==Id).OrderBy(x=>x.FullName).ToList();
    List<Worker> SelectableFarmWorkers=>FarmWorkers.Where(x=>x.IsActive).ToList();
    List<Worker> AssignableWorkers=>allWorkers.Where(x=>!x.FarmId.HasValue).OrderBy(x=>x.FullName).ToList();
    List<StockRow> Stocks=>farmSupplyEntries.GroupBy(x=>new{x.SupplyId,x.SupplyPriceId,x.SupplyName,x.SupplyType,x.Unit,x.UnitPrice}).Select(g=>new StockRow(g.Key.SupplyId,g.Key.SupplyPriceId,g.Key.SupplyName,g.Key.SupplyType,g.Key.Unit,g.Key.UnitPrice,g.Sum(x=>x.Quantity),g.Sum(x=>x.RemainingQuantity),g.Count())).OrderBy(x=>x.Name).ThenBy(x=>x.UnitPrice).ToList();
    protected override async Task OnParametersSetAsync(){detail=await Api.Farm(Id);allSupplies=await Api.Supplies();farmSupplyEntries=await Api.FarmSupplies(Id);allWorkers=await Api.Workers();payrolls=await Api.Payroll(Id);workTypes=await Api.WorkTypes();}
    async Task SaveNote(){await Api.AddNote(Id,note);detail=await Api.Farm(Id);note=new();showNote=false;}
    List<FarmProcessExtraStep> ExtraSteps(Guid processId)=>detail?.ExtraSteps.Where(x=>x.WorkProcessId==processId).OrderBy(x=>x.Order).ToList()??[];
    void OpenExtraStep(WorkProcess process){selectedProcessId=process.Id;selectedProcessName=process.Name;extraStep=new(){FarmId=Id,WorkProcessId=process.Id};showExtraStep=true;}
    void CloseExtraStep(){showExtraStep=false;selectedProcessId=Guid.Empty;selectedProcessName="";extraStep=new();}
    async Task SaveExtraStep(){await Api.AddExtraStep(Id,selectedProcessId,extraStep);detail=await Api.Farm(Id);CloseExtraStep();}
    async Task DeleteExtraStep(Guid processId,FarmProcessExtraStep step){if(!await JS.InvokeAsync<bool>("confirm",$"Xóa bước riêng '{step.Title}' khỏi nông trại này?"))return;await Api.DeleteExtraStep(Id,processId,step.Id);detail=await Api.Farm(Id);}
    void OpenStartRun(WorkProcess process){selectedProcessId=process.Id;selectedProcessName=process.Name;runRequest=new(){SeasonName=$"Mùa vụ {DateTime.Today:yyyy}",StartDate=DateTime.Today};showStartRun=true;}
    void CloseStartRun(){showStartRun=false;selectedProcessId=Guid.Empty;selectedProcessName="";runRequest=new();}
    async Task StartRun(){await Api.StartProcessRun(Id,selectedProcessId,runRequest);detail=await Api.Farm(Id);CloseStartRun();}
    async Task ToggleRunStep(FarmProcessRun run,FarmProcessRunStep step,bool completed){await Api.SetRunStepCompleted(Id,run.Id,step.Id,completed);detail=await Api.Farm(Id);}
    static string Money(decimal value)=>value.ToString("N0",new CultureInfo("vi-VN"))+" ₫";
    static string Money2(decimal value)=>value.ToString("N2",new CultureInfo("vi-VN"))+" đ";
    string SelectedSupplyUnit=>allSupplies.FirstOrDefault(x=>x.Id==provision.SupplyId)?.Unit??"đơn vị";
    void OpenProvision(){provision=new(){ReceivedAt=DateTime.Today};selectedPrices=[];stockError="";showProvision=true;}
    void CloseProvision(){showProvision=false;stockError="";}
    async Task LoadSelectedPrices(){provision.SupplyPriceId=Guid.Empty;selectedPrices=provision.SupplyId==Guid.Empty?[]:await Api.SupplyPrices(provision.SupplyId);}
    async Task SaveProvision(){if(provision.SupplyId==Guid.Empty||provision.SupplyPriceId==Guid.Empty){stockError="Vui lòng chọn vật tư và mức giá.";return;}try{await Api.ProvisionFarmSupply(Id,provision);farmSupplyEntries=await Api.FarmSupplies(Id);CloseProvision();}catch(HttpRequestException){stockError="Không thể nhập kho. Hãy kiểm tra số lượng và mức giá.";}}
    void OpenUse(StockRow stock){selectedStock=stock;useRequest=new(){SupplyId=stock.SupplyId,SupplyPriceId=stock.SupplyPriceId,UsedAt=DateTime.Today};stockError="";showUse=true;}
    void CloseUse(){showUse=false;selectedStock=null;stockError="";}
    async Task SaveUse(){if(string.IsNullOrWhiteSpace(useRequest.Worker)){stockError="Vui lòng nhập người thực hiện.";return;}try{await Api.UseFarmSupply(Id,useRequest);farmSupplyEntries=await Api.FarmSupplies(Id);detail=await Api.Farm(Id);CloseUse();}catch(HttpRequestException){stockError="Số lượng sử dụng không hợp lệ hoặc vượt quá tồn kho.";}}
    void OpenHistory(Guid supplyId,Guid supplyPriceId){historyEntries=farmSupplyEntries.Where(x=>x.SupplyId==supplyId&&x.SupplyPriceId==supplyPriceId).OrderByDescending(x=>x.ReceivedAt).ToList();showHistory=true;}
    void OpenAddWorker(){workerModel=NewWorker();workerModel.FarmId=Id;showWorkerForm=true;}
    void CloseWorkerForm(){showWorkerForm=false;workerModel=NewWorker();}
    async Task SaveWorker(){workerModel.FarmId=Id;await Api.AddWorker(workerModel);allWorkers=await Api.Workers();CloseWorkerForm();}
    void OpenAssignWorker(){selectedWorkerId=Guid.Empty;showAssignWorker=true;}
    void CloseAssignWorker(){showAssignWorker=false;selectedWorkerId=Guid.Empty;}
    async Task AssignWorker(){var worker=allWorkers.FirstOrDefault(x=>x.Id==selectedWorkerId);if(worker is null)return;worker.FarmId=Id;await Api.UpdateWorker(worker.Id,worker);allWorkers=await Api.Workers();CloseAssignWorker();}
    WorkerPayroll PayrollOf(Guid workerId)=>payrolls.FirstOrDefault(x=>x.WorkerId==workerId)??new(){WorkerId=workerId};
    decimal SelectedWorkDateFraction=>payrollWorker is null?0:PayrollOf(payrollWorker.Id).WorkDays.Where(x=>x.WorkDate.Date==payrollDate.Date).Sum(x=>x.WorkFraction);
    bool SelectedWorkDateIsFull=>SelectedWorkDateFraction>=1;
    void ValidatePayrollDate(){payrollError=SelectedWorkDateIsFull?$"Ngày {payrollDate:dd/MM/yyyy} đã được chấm đủ 1 công. Vui lòng chọn ngày khác.":"";}
    void OpenWorkDay(Worker worker){payrollWorker=worker;payrollDate=DateTime.Today;selectedWorkTypeId=Guid.Empty;workFraction=1;settlingPayroll=false;ValidatePayrollDate();showPayrollAction=true;}
    void OpenSettlement(Worker worker){payrollWorker=worker;payrollDate=DateTime.Today;settlingPayroll=true;payrollError="";showPayrollAction=true;}
    void ClosePayrollAction(){showPayrollAction=false;payrollWorker=null;payrollError="";}
    async Task SavePayrollAction(){if(payrollWorker is null)return;if(!settlingPayroll&&selectedWorkTypeId==Guid.Empty){payrollError="Vui lòng chọn công việc.";return;}try{if(settlingPayroll){await Api.SettleWorkerPayroll(Id,payrollWorker.Id,payrollDate);detail=await Api.Farm(Id);}else await Api.AddWorkerWorkDay(Id,payrollWorker.Id,new(){WorkDate=payrollDate,WorkTypeId=selectedWorkTypeId,WorkFraction=workFraction});payrolls=await Api.Payroll(Id);ClosePayrollAction();}catch(HttpRequestException){payrollError=settlingPayroll?"Không có công chưa trả để tất toán.":"Không thể thêm: tổng công trong ngày không được vượt quá 1.";}}
    static Worker NewWorker()=>new(){StartDate=DateTime.Today,IsActive=true};
    record StockRow(Guid SupplyId,Guid SupplyPriceId,string Name,SupplyType Type,string Unit,decimal UnitPrice,decimal Received,decimal Remaining,int EntryCount);
}
