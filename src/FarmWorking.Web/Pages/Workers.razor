@page "/workers"
@inject FarmApi Api
<PageTitle>Nhân công · Lá Farm</PageTitle>
<div class="page-heading"><div><span class="eyebrow">NHÂN SỰ</span><h1>Danh sách nhân công</h1><p>Quản lý nhân công theo từng nông trại.</p></div><button class="btn primary" @onclick="OpenCreate">+ Thêm nhân công</button></div>
<div class="finance-summary worker-summary"><div><span>TỔNG NHÂN CÔNG</span><strong>@items.Count</strong></div><div><span>ĐANG LÀM VIỆC</span><strong class="money-in">@items.Count(x=>x.IsActive)</strong></div></div>
<section class="panel"><div class="panel-head"><div><h2>Nhân công</h2><p>@Filtered.Count() người</p></div><div class="transaction-filters"><select class="filter" @bind="farmFilter"><option value="all" hidden="@(farmFilter=="all")">Tất cả nông trại</option><option value="unassigned">Chưa phân trại</option>@foreach(var farm in farms){<option value="@farm.Id">@farm.Name</option>}</select><select class="filter" @bind="filter"><option value="all" hidden="@(filter=="all")">Tất cả trạng thái</option><option value="active">Đang làm việc</option><option value="inactive">Đã nghỉ</option></select></div></div><div class="data-table"><div class="table-head worker-row"><span>Họ tên</span><span>Nông trại</span><span>Liên hệ</span><span>Công việc</span><span>Trạng thái</span><span>Thao tác</span></div>@if(!Filtered.Any()){<div class="empty">Không có nhân công phù hợp.</div>}@foreach(var worker in Filtered){<div class="table-row worker-row"><strong>@worker.FullName</strong><span>@FarmName(worker.FarmId)</span><span>@(string.IsNullOrWhiteSpace(worker.Phone)?"—":worker.Phone)</span><span>@(string.IsNullOrWhiteSpace(worker.Role)?"—":worker.Role)</span><span><em class="tag @(worker.IsActive?"":"inactive-tag")">@(worker.IsActive?"Đang làm":"Đã nghỉ")</em></span><span class="row-actions"><button class="btn small ghost" @onclick="()=>OpenEdit(worker)">Sửa</button><button class="btn small danger" @onclick="()=>Remove(worker.Id)">Xóa</button></span></div>}</div></section>
@if(showForm){<div class="modal-backdrop" @onclick="CloseForm"><div class="modal" @onclick:stopPropagation><div class="modal-head"><div><span class="eyebrow">@(editingId.HasValue?"CẬP NHẬT":"NHÂN CÔNG MỚI")</span><h2>@(editingId.HasValue?"Sửa thông tin nhân công":"Thêm nhân công")</h2></div><button class="icon-btn" @onclick="CloseForm">×</button></div><EditForm Model="model" OnValidSubmit="Save"><div class="form-grid"><label>Họ và tên<input required @bind="model.FullName" /></label><label>Nông trại<select @bind="model.FarmId"><option value="" hidden="@(!model.FarmId.HasValue)">Chưa phân trại</option>@foreach(var farm in farms){<option value="@farm.Id">@farm.Name</option>}</select></label><label>Số điện thoại<input type="tel" @bind="model.Phone" /></label><label>Địa chỉ<input @bind="model.Address" /></label><label>Công việc / vai trò<input @bind="model.Role" placeholder="VD: Chăm sóc cây" /></label><label>Ngày bắt đầu<input type="date" @bind="model.StartDate" /></label><label class="wide checkbox-label"><input type="checkbox" @bind="model.IsActive" /> Đang làm việc</label><label class="wide">Ghi chú<textarea rows="3" @bind="model.Notes"></textarea></label></div><div class="modal-actions"><button type="button" class="btn ghost" @onclick="CloseForm">Hủy</button><button class="btn primary">@(editingId.HasValue?"Lưu thay đổi":"Thêm nhân công")</button></div></EditForm></div></div>}
@code {
 List<Worker> items=[]; List<Farm> farms=[]; Worker model=NewWorker(); Guid? editingId; bool showForm; string filter="all"; string farmFilter="all";
 IEnumerable<Worker> Filtered=>items.Where(x=>(farmFilter=="all"||(farmFilter=="unassigned"&&!x.FarmId.HasValue)||x.FarmId?.ToString()==farmFilter)&&(filter=="all"||(filter=="active"&&x.IsActive)||(filter=="inactive"&&!x.IsActive)));
 protected override async Task OnInitializedAsync(){farms=await Api.Farms();items=await Api.Workers();}
 void OpenCreate(){editingId=null;model=NewWorker();showForm=true;} void OpenEdit(Worker x){editingId=x.Id;model=Copy(x);showForm=true;} void CloseForm(){showForm=false;editingId=null;model=NewWorker();}
 async Task Save(){if(editingId.HasValue)await Api.UpdateWorker(editingId.Value,model);else await Api.AddWorker(model);items=await Api.Workers();CloseForm();} async Task Remove(Guid id){await Api.DeleteWorker(id);items=await Api.Workers();}
 string FarmName(Guid? id)=>farms.FirstOrDefault(x=>x.Id==id)?.Name??"Chưa phân trại"; static Worker NewWorker()=>new(){StartDate=DateTime.Today,IsActive=true}; static Worker Copy(Worker x)=>new(){Id=x.Id,FarmId=x.FarmId,FullName=x.FullName,Phone=x.Phone,Address=x.Address,Role=x.Role,DailyWage=x.DailyWage,StartDate=x.StartDate,IsActive=x.IsActive,Notes=x.Notes}; static string Money(decimal value)=>value.ToString("N0",new CultureInfo("vi-VN"))+" ₫";
}
